# Copy this file to .env and change the secret before running in production.

# Port the Express server listens on
PORT=3000

# Secret used to sign JWTs. MUST be changed to a long random string.
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
# How long a login session stays valid
JWT_EXPIRES_IN=7d

# "development" or "production". In production the auth cookie is marked Secure.
NODE_ENV=development

# Comma-separated list of origins allowed by CORS (same-origin needs no entry)
CORS_ORIGIN=http://localhost:3000

# Path to the SQLite database file (relative to the project root)
DB_PATH=server/db/data/app.db

# Brute-force protection on /api/auth/login and /api/auth/register:
# how many attempts one IP may make per window.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MIN=15
