# Project 4: Real-Time Communication App (Meet)
# Copy this file to .env and set JWT_SECRET before starting the server.

# Port this task listens on. Each task uses a different default, so all four
# can run at the same time.
PORT=3004

# Secret used to sign JWTs. The server refuses to start without it.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# How long a login session stays valid
JWT_EXPIRES_IN=7d

# "development" or "production". In production the auth cookie is marked Secure.
NODE_ENV=development

# Comma-separated list of origins allowed by CORS (same-origin needs no entry)
CORS_ORIGIN=http://localhost:3004

# Path to the SQLite database file (relative to this task folder)
DB_PATH=server/db/data/app.db

# Brute-force protection on /api/auth/login and /api/auth/register:
# how many attempts one IP may make per window.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MIN=15
